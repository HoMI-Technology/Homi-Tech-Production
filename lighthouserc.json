{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in|Local:|started server",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/how-it-works",
        "http://localhost:3000/method",
        "http://localhost:3000/pricing",
        "http://localhost:3000/assessment",
        "http://localhost:3000/results",
        "http://localhost:3000/tools",
        "http://localhost:3000/tools/mortgage",
        "http://localhost:3000/shadow-score"
      ],
      "settings": {
        "budgetsPath": "./lighthouse-budget.json"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3000/$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.75 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.15 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 4500 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 800 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 368640 }],
            "resource-summary:total:size": ["warn", { "maxNumericValue": 1638400 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/shadow-score$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.15 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 450 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 368640 }],
            "resource-summary:total:size": ["warn", { "maxNumericValue": 1638400 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/.+",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.15 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 4500 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 800 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 368640 }],
            "resource-summary:total:size": ["warn", { "maxNumericValue": 1638400 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
