# HōMI — environment variables
# Copy to .env.local (`cp .env.example .env.local`) and fill in real values.
# Every var the codebase reads is listed here. Placeholders only — never
# commit real secrets. Optional integrations degrade gracefully when absent.
# See README.md → "Environment variables" for the canonical table.
#
# ── Tier 1 (CI / local build) ─────────────────────────────────────────
# Enough for `npm run typecheck`, `npm run test`, `npm run build`, and
# `npm run dev`. CI uses the publishable values in `.github/workflows/ci.yml`.
# Smoke-check connectivity: `npm run verify-supabase`
#
# ── Tier 2 (live Supabase + auth) ───────────────────────────────────
# Requires a real SUPABASE_SERVICE_ROLE_KEY (Dashboard → Settings → API).
# Also set E2E_SUPABASE_SERVICE_ROLE_KEY to the same value for live Playwright
# specs. Auth redirect allowlist must include `http://localhost:3000/**`
# (Supabase Dashboard → Auth → URL Configuration). See e2e/README.md.
#
# Easy signed-in smoke (no service role — just an account you own):
#   SMOKE_EMAIL=you@example.com
#   SMOKE_PASSWORD=YourPassword1
#   npm run smoke:auth
# Optional: SMOKE_BASE_URL=https://homitechnology.com  (default)

# ───────────────────────────── Required ─────────────────────────────

# Supabase project URL (client-safe)
# Tier 1 CI value: https://giyycykxkzfbowiapxpd.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (client-safe)
# Tier 1: use the legacy anon key from ci.yml or `npm run verify-supabase`
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (server-side only — never expose to the browser)
# Tier 2: required for create-admin, webhooks, and live E2E user factory
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Canonical site URL used for metadata, sitemaps, and redirects
# (code falls back to https://homitechnology.com when unset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────── Optional integrations ──────────────────────

# Anthropic — enables the AI advisor; falls back gracefully when absent
ANTHROPIC_API_KEY=

# Stripe — billing (checkout/webhooks run only when STRIPE_SECRET_KEY is set)
STRIPE_SECRET_KEY=
# Verifies Stripe webhook signatures
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs for each tier
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FAMILY=

# Plaid — bank sync
PLAID_CLIENT_ID=
PLAID_SECRET=
# Plaid environment: sandbox | development | production
PLAID_ENV=sandbox
# Encrypts stored Plaid access tokens — base64 for exactly 32 bytes
# (generate with `openssl rand -base64 32`)
PLAID_TOKEN_KEY=

# Resend — transactional email
RESEND_API_KEY=
# Optional sender override (default: "HōMI <hello@homitechnology.com>"). Must be
# an address on the Resend-verified domain or every send 403s — see
# GO-LIVE-CHECKLIST §1. Leave blank to use the canonical brand identity.
EMAIL_FROM=

# Sentry — server/edge error capture; SDK stays uninitialized when absent
SENTRY_DSN=

# Sentry source-map upload (build-time only, optional). Without these, errors
# still arrive but stack frames point at minified output. next.config.ts engages
# the upload only when ALL THREE are set, so a partial config builds exactly as
# before rather than failing mid-upload. Create the token at
# Sentry → Settings → Auth Tokens with the `project:releases` scope.
# These belong in Vercel (build environment), not just .env.local.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog — product analytics; ships zero analytics weight when key is absent
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host — URL only, no inline comments (default: https://us.i.posthog.com)
# US: https://us.i.posthog.com
# EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
# PostHog personal API key (server-only) — powers the /admin/analytics
# dashboard via the HogQL Query API. Create in PostHog → Settings → Personal
# API keys (needs the "query" read scope). Dashboard renders a setup guide
# when absent.
POSTHOG_PERSONAL_API_KEY=
# PostHog project ID (optional) — auto-detected from the personal API key +
# project token when blank
POSTHOG_PROJECT_ID=

# Upstash — Redis-backed rate limiting shared across serverless instances;
# in-memory fallback when absent (both vars required together)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth — set to "1" to show the "Continue with Google" sign-in button
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=

# Apple OAuth — set to "1" to show the "Continue with Apple" sign-in button.
# Disabled by default; requires an Apple Developer account to configure.
NEXT_PUBLIC_APPLE_OAUTH_ENABLED=0

# ───────────────────────── Feature flags ────────────────────────────

# Agent OS — enables the multi-agent ensemble (/agents, /api/agents)
NEXT_PUBLIC_FF_AGENT_OS=false

# Path closed-loop feedback. Enable only on the PR Preview until accepted.
NEXT_PUBLIC_FF_IMPACT_BUS=false

# ─────────────────── Server-only secrets (app routes) ───────────────

# Guards POST /api/email (x-homi-internal header)
INTERNAL_API_SECRET=

# Signs email unsubscribe links; falls back to INTERNAL_API_SECRET when unset
EMAIL_UNSUBSCRIBE_SECRET=

# Bearer token for the /api/cron/* crons (reassessment + outcome-surveys)
CRON_SECRET=

# Signs Agent OS receipts (HMAC-SHA256); generate with `openssl rand -hex 32`
# NOTE: the name is ..._SECRET. `RECEIPT_SIGNING_KEY` was the old name and is no
# longer read anywhere — lib/receipts/index.ts reads RECEIPT_SIGNING_SECRET.
# Setting the old name leaves receipts unsigned with no error.
RECEIPT_SIGNING_SECRET=

# Web Push (outcome-survey nudges). All push code is inert until these are set.
# Generate a keypair: `npx web-push generate-vapid-keys`
# - NEXT_PUBLIC_VAPID_PUBLIC_KEY is public by design (shipped to the browser).
# - VAPID_PRIVATE_KEY is server-only — never prefix it with NEXT_PUBLIC_.
# - VAPID_SUBJECT is a mailto:/https: contact; defaults to mailto:hello@<site>.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─────────────── Scripts & local tooling (not used by the app) ──────

# Tier 2 E2E — same service-role key as above; specs read E2E_* names
# E2E_SUPABASE_URL=https://giyycykxkzfbowiapxpd.supabase.co
# E2E_SUPABASE_SERVICE_ROLE_KEY=

# scripts/create-admin.mjs — target email (or pass as first CLI arg)
# ADMIN_EMAIL=

# Vercel API token for scripts/push-vercel-env.mjs (`npm run vercel-env`).
# Create at https://vercel.com/account/tokens, scoped to the team owning this
# project. Lets you set Vercel env vars from this file without opening the
# dashboard and without a secret ever touching a command line:
#   1. add the value here, e.g.  SENTRY_DSN=https://...
#   2. npm run vercel-env -- SENTRY_DSN
# Writes Production + Preview by default (the recurring mistake has been
# setting Production only). Revoke the token in one click when done.
# VERCEL_TOKEN=

# ── Admin console hardening (optional, defense-in-depth) ──────────────
# Allowlist of admin emails (comma/space separated). When set, a profile
# with role='admin' is refused the /admin console unless its email is
# listed — so a forged/compromised profile row alone can't mint admin.
# Unset = role-only gating (historical behaviour).
# ADMIN_EMAILS=info@homitechnology.com
# When "1", admins must have a verified TOTP factor (AAL2) to enter the
# console; those without one are routed to enroll. Default off.
# ADMIN_REQUIRE_MFA=1
# scripts/create-admin.mjs — fallback for NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_URL=
# scripts/stripe-setup.mjs uses STRIPE_SECRET_KEY (above).
# Lighthouse CI (GitHub Actions secrets, not .env.local): LHCI_TEST_EMAIL,
#   LHCI_TEST_PASSWORD
# Opt-in RLS integration tests (__tests__/acceptance): RUN_RLS_IT=1 plus
#   SUPABASE_URL, USER_A_JWT, USER_B_JWT

# ─────────────── Dev-only escape hatch (NEVER set in prod) ──────────

# Bypasses Plaid webhook JWT verification; ignored in production
# PLAID_WEBHOOK_SKIP_VERIFY=true

# Platform-provided (do not set): VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA,
# NEXT_RUNTIME, NODE_ENV. NEXT_PUBLIC_COMMIT_SHA is only a non-Vercel
# fallback for the /api/healthcheck build stamp.
