    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.42.2",
    "next": "^15.5.21",
    "next-intl": "^4.13.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-plaid-link": "^4.2.0",
    "stripe": "^22.3.2",
