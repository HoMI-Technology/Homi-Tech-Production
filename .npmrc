# legacy-peer-deps: npm 10's resolver chases @vercel/speed-insights' *optional*
# framework peers (svelte → @sveltejs/kit → vite@8) into a conflict with
# vitest's vite@5-7. The peers we actually use (next, react) are satisfied;
# this skips auto-installing the rest. Applies to installs everywhere (dev,
# CI, Vercel) so the lockfile stays coherent.
legacy-peer-deps=true
